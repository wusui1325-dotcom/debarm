<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- App downloads are HTTPS. Debian apt still commonly uses http://deb.debian.org. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="true">debian.org</domain>
        <domain includeSubdomains="true">deb.debian.org</domain>
        <domain includeSubdomains="true">security.debian.org</domain>
        <domain includeSubdomains="true">cdn-aws.deb.debian.org</domain>
        <domain includeSubdomains="true">ftp.debian.org</domain>
    </domain-config>
</network-security-config>
